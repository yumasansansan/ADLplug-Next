{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 29, "patch": 0 },

  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "environment": {
        "CC": "clang",
        "CXX": "clang++",
        "RC": "llvm-rc",
        "LDFLAGS": "-fuse-ld=lld"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_LINKER_TYPE": "LLD",
        "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=lld",
        "CMAKE_MODULE_LINKER_FLAGS": "-fuse-ld=lld",
        "CMAKE_SHARED_LINKER_FLAGS": "-fuse-ld=lld",
        "CMAKE_AR": "llvm-ar",
        "CMAKE_RANLIB": "llvm-ranlib",
        "CMAKE_NM": "llvm-nm",
        "CMAKE_OBJCOPY": "llvm-objcopy",
        "CMAKE_OBJDUMP": "llvm-objdump",
        "CMAKE_STRIP": "llvm-strip",
        "CMAKE_READELF": "llvm-readelf",
        "CMAKE_ADDR2LINE": "llvm-addr2line",
        "CMAKE_DLLTOOL": "llvm-dlltool",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "ADLplug_WERROR": "ON",
        "ADLplug_PRESET": "${presetName}"
      }
    },

    {
      "name": "adl",
      "hidden": true,
      "cacheVariables": { "ADLplug_CHIP": "OPL3" }
    },
    {
      "name": "opn",
      "hidden": true,
      "cacheVariables": { "ADLplug_CHIP": "OPN2" }
    },

    {
      "name": "debug",
      "hidden": true,
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "relwithdebinfo",
      "hidden": true,
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "release",
      "hidden": true,
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "sanitize",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "ADLplug_SANITIZERS": "address,undefined,vptr"
      }
    },
    {
      "name": "sanitize-thread",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "ADLplug_SANITIZERS": "thread,undefined"
      }
    },
    {
      "name": "sanitize-memory",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "ADLplug_SANITIZERS": "memory,undefined"
      }
    },

    {
      "name": "adl-debug",
      "displayName": "ADLplug (OPL3) — Debug",
      "inherits": ["base", "adl", "debug"]
    },
    {
      "name": "adl-relwithdebinfo",
      "displayName": "ADLplug (OPL3) — RelWithDebInfo",
      "inherits": ["base", "adl", "relwithdebinfo"]
    },
    {
      "name": "adl-release",
      "displayName": "ADLplug (OPL3) — Release (distribution: ThinLTO, no debug info)",
      "inherits": ["base", "adl", "release"]
    },
    {
      "name": "adl-sanitize",
      "displayName": "ADLplug (OPL3) — RelWithDebInfo with the address, undefined and vptr sanitizers",
      "inherits": ["base", "adl", "sanitize"]
    },
    {
      "name": "adl-tsan",
      "displayName": "ADLplug (OPL3) — RelWithDebInfo with the thread and undefined sanitizers",
      "inherits": ["base", "adl", "sanitize-thread"]
    },
    {
      "name": "adl-msan",
      "displayName": "ADLplug (OPL3) — RelWithDebInfo with the memory and undefined sanitizers (needs ADLplug_MSAN_LIBCXX)",
      "inherits": ["base", "adl", "sanitize-memory"]
    },
    {
      "name": "opn-debug",
      "displayName": "OPNplug (OPN2) — Debug",
      "inherits": ["base", "opn", "debug"]
    },
    {
      "name": "opn-relwithdebinfo",
      "displayName": "OPNplug (OPN2) — RelWithDebInfo",
      "inherits": ["base", "opn", "relwithdebinfo"]
    },
    {
      "name": "opn-release",
      "displayName": "OPNplug (OPN2) — Release (distribution: ThinLTO, no debug info)",
      "inherits": ["base", "opn", "release"]
    },
    {
      "name": "opn-sanitize",
      "displayName": "OPNplug (OPN2) — RelWithDebInfo with the address, undefined and vptr sanitizers",
      "inherits": ["base", "opn", "sanitize"]
    },
    {
      "name": "opn-tsan",
      "displayName": "OPNplug (OPN2) — RelWithDebInfo with the thread and undefined sanitizers",
      "inherits": ["base", "opn", "sanitize-thread"]
    },
    {
      "name": "opn-msan",
      "displayName": "OPNplug (OPN2) — RelWithDebInfo with the memory and undefined sanitizers (needs ADLplug_MSAN_LIBCXX)",
      "inherits": ["base", "opn", "sanitize-memory"]
    }
  ],

  "buildPresets": [
    { "name": "adl-debug",          "configurePreset": "adl-debug" },
    { "name": "adl-relwithdebinfo", "configurePreset": "adl-relwithdebinfo" },
    { "name": "adl-release",        "configurePreset": "adl-release" },
    { "name": "adl-sanitize",       "configurePreset": "adl-sanitize",       "environment": { "ASAN_OPTIONS": "detect_leaks=0" } },
    { "name": "adl-tsan",           "configurePreset": "adl-tsan" },
    { "name": "adl-msan",           "configurePreset": "adl-msan" },
    { "name": "opn-debug",          "configurePreset": "opn-debug" },
    { "name": "opn-relwithdebinfo", "configurePreset": "opn-relwithdebinfo" },
    { "name": "opn-release",        "configurePreset": "opn-release" },
    { "name": "opn-sanitize",       "configurePreset": "opn-sanitize",       "environment": { "ASAN_OPTIONS": "detect_leaks=0" } },
    { "name": "opn-tsan",           "configurePreset": "opn-tsan" },
    { "name": "opn-msan",           "configurePreset": "opn-msan" }
  ],

  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "timeout": 1200 }
    },
    { "name": "adl-debug",          "configurePreset": "adl-debug",          "inherits": "base" },
    { "name": "adl-relwithdebinfo", "configurePreset": "adl-relwithdebinfo", "inherits": "base" },
    { "name": "adl-release",        "configurePreset": "adl-release",        "inherits": "base" },
    { "name": "adl-sanitize",       "configurePreset": "adl-sanitize",       "inherits": "base",
      "output": { "outputOnFailure": true, "verbosity": "verbose" } },
    { "name": "adl-tsan",           "configurePreset": "adl-tsan",           "inherits": "base",
      "output": { "outputOnFailure": true, "verbosity": "verbose" } },
    { "name": "adl-msan",           "configurePreset": "adl-msan",           "inherits": "base",
      "output": { "outputOnFailure": true, "verbosity": "verbose" } },
    { "name": "opn-debug",          "configurePreset": "opn-debug",          "inherits": "base" },
    { "name": "opn-relwithdebinfo", "configurePreset": "opn-relwithdebinfo", "inherits": "base" },
    { "name": "opn-release",        "configurePreset": "opn-release",        "inherits": "base" },
    { "name": "opn-sanitize",       "configurePreset": "opn-sanitize",       "inherits": "base",
      "output": { "outputOnFailure": true, "verbosity": "verbose" } },
    { "name": "opn-tsan",           "configurePreset": "opn-tsan",           "inherits": "base",
      "output": { "outputOnFailure": true, "verbosity": "verbose" } },
    { "name": "opn-msan",           "configurePreset": "opn-msan",           "inherits": "base",
      "output": { "outputOnFailure": true, "verbosity": "verbose" } }
  ]
}
