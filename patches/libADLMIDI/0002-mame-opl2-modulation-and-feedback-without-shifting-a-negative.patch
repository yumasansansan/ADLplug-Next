MAME OPL2: the phase modulation and the feedback without shifting a negative

The OPL2 core scales two signed values with a left shift, which is undefined
behaviour when they are negative. UndefinedBehaviorSanitizer stops the program
at the first of them, a few milliseconds into a note:

  src/chips/mame/mame_fmopl.cpp:801:78: runtime error: left shift of negative
  value -8

* op_calc() scales the phase modulation by 65536. The sum it feeds is worked
  out in an unsigned type, as before, so nothing else about the expression
  changes.

* The three channel calculations scale the feedback, the sum of the two
  previous outputs of operator 1, by the feedback shift. The shift is 0, or 8
  to 14 for the seven feedback settings of the chip, and the sum stays within
  about 16384, so the product is inside an int.

Multiplications say the same thing and are defined. The YM2612 and YM2608
cores of libOPNMIDI have the same two lines, from the same MAME sources.

This is ADLplug-Next's own patch, applied to the submodule by
cmake/Patches.cmake when CMake configures, and it goes away once the change is
upstream.

diff --git a/src/chips/mame/mame_fmopl.cpp b/src/chips/mame/mame_fmopl.cpp
index 3731211..42783bc 100644
--- a/src/chips/mame/mame_fmopl.cpp
+++ b/src/chips/mame/mame_fmopl.cpp
@@ -798,7 +798,7 @@ static inline signed int op_calc(uint32_t phase, unsigned int env, signed int pm
 {
 	uint32_t p;
 
-	p = (env<<4) + sin_tab[wave_tab + ((((signed int)((phase & ~FREQ_MASK) + (pm<<16))) >> FREQ_SH ) & SIN_MASK) ];
+	p = (env<<4) + sin_tab[wave_tab + ((((signed int)((phase & ~FREQ_MASK) + (pm * 65536))) >> FREQ_SH ) & SIN_MASK) ];
 
 	if (p >= TL_TAB_LEN)
 		return 0;
@@ -839,7 +839,7 @@ static inline float OPL_CALC_CH( FM_WorkTable *wt, OPL_CH *CH )
 	{
 		if (!SLOT->FB)
 			out = 0;
-		SLOT->op1_out[1] = op_calc1(SLOT->Cnt, env, (out<<SLOT->FB), SLOT->wavetable );
+		SLOT->op1_out[1] = op_calc1(SLOT->Cnt, env, (out * (1 << SLOT->FB)), SLOT->wavetable );
 	}
 
 	/* SLOT 2 */
@@ -873,7 +873,7 @@ static inline short OPL_CALC_CH_S( FM_WorkTable *wt, OPL_CH *CH )
 	{
 		if (!SLOT->FB)
 			out = 0;
-		SLOT->op1_out[1] = op_calc1(SLOT->Cnt, env, (out<<SLOT->FB), SLOT->wavetable );
+		SLOT->op1_out[1] = op_calc1(SLOT->Cnt, env, (out * (1 << SLOT->FB)), SLOT->wavetable );
 	}
 
 	/* SLOT 2 */
@@ -955,7 +955,7 @@ static inline void OPL_CALC_RH( FM_WorkTable *wt, OPL_CH *CH, unsigned int noise
 	{
 		if (!SLOT->FB)
 			out = 0;
-		SLOT->op1_out[1] = op_calc1(SLOT->Cnt, env, (out<<SLOT->FB), SLOT->wavetable );
+		SLOT->op1_out[1] = op_calc1(SLOT->Cnt, env, (out * (1 << SLOT->FB)), SLOT->wavetable );
 	}
 
 	/* SLOT 2 */
