WOPL: a version of 0 is not a version

The versions of WOPL are 1 to 3, but the loaders of banks and of instrument
files turn away only a version newer than they know, and take a version of 0.
Saving uses 0 for "the latest version", so such a bank does not survive being
saved in its own version and loaded back: it comes back as version 3. A
fuzzer found this with a bank of 152 bytes, the magic and zeros.

Both loaders now turn a version of 0 away, with a new error code at the end of
the enumeration, WOPL_ERR_INVALID_VERSION, and the loading of a custom bank
says so. Files that any tool writes are not affected.

This is ADLplug-Next's own patch, applied to the submodule by
cmake/Patches.cmake when CMake configures, and it goes away once the change is
upstream.

diff --git a/src/adlmidi_load.cpp b/src/adlmidi_load.cpp
index ad32f30..6a68293 100644
--- a/src/adlmidi_load.cpp
+++ b/src/adlmidi_load.cpp
@@ -102,6 +102,9 @@ bool MIDIplay::LoadBank(FileAndMemReader &fr)
         case WOPL_ERR_NEWER_VERSION:
             errorStringOut = "Custom bank: Version is newer than supported by this library!";
             return false;
+        case WOPL_ERR_INVALID_VERSION:
+            errorStringOut = "Custom bank: Invalid version!";
+            return false;
         case WOPL_ERR_OUT_OF_MEMORY:
             errorStringOut = "Custom bank: Out of memory!";
             return false;
diff --git a/src/wopl/wopl_file.c b/src/wopl/wopl_file.c
index 5e39352..ad6a304 100644
--- a/src/wopl/wopl_file.c
+++ b/src/wopl/wopl_file.c
@@ -249,6 +249,11 @@ WOPLFile *WOPL_LoadBankFromMem(void *mem, size_t length, int *error)
             return NULL;
         }
         version = toUint16LE(cursor);
+        if(version == 0)
+        {
+            SET_ERROR(WOPL_ERR_INVALID_VERSION);
+            return NULL;
+        }
         if(version  > wopl_latest_version)
         {
             SET_ERROR(WOPL_ERR_NEWER_VERSION);
@@ -361,6 +366,8 @@ int WOPL_LoadInstFromMem(WOPIFile *file, void *mem, size_t length)
         if(length < 2)
             return WOPL_ERR_UNEXPECTED_ENDING;
         version = toUint16LE(cursor);
+        if(version == 0)
+            return WOPL_ERR_INVALID_VERSION;
         if(version  > wopl_latest_version)
             return WOPL_ERR_NEWER_VERSION;
         GO_FORWARD(2);
diff --git a/src/wopl/wopl_file.h b/src/wopl/wopl_file.h
index 1e90682..b17ade8 100644
--- a/src/wopl/wopl_file.h
+++ b/src/wopl/wopl_file.h
@@ -132,7 +132,9 @@ typedef enum WOPL_ErrorCodes
     /* Out of memory */
     WOPL_ERR_OUT_OF_MEMORY,
     /* Given null pointer memory data */
-    WOPL_ERR_NULL_POINTER
+    WOPL_ERR_NULL_POINTER,
+    /* Version of file is not a version of the format */
+    WOPL_ERR_INVALID_VERSION
 } WOPL_ErrorCodes;
 
