-    ADL_UNUSED(sampleCount);
-    ADL_UNUSED(out_left);
-    ADL_UNUSED(out_right);
-    ADL_UNUSED(format);
-    return 0;
-#else
     sampleCount -= sampleCount % 2; //Avoid even sample requests
 
     if(sampleCount < 0)
@@ -1805,7 +1871,7 @@ ADLMIDI_EXPORT int adl_generateFormat(struct ADL_MIDIPlayer *device, int sampleC
             }
 
             /* Process it */
-            if(SendStereoAudio(sampleCount, in_generatedStereo, out_buf, gotten_len, out_left, out_right, format) == -1)
+            if(SendGenerated(sampleCount, in_generatedStereo, out_buf, gotten_len, target) == -1)
                 return 0;
 
             left -= (int)in_generatedPhys;
@@ -1816,6 +1882,43 @@ ADLMIDI_EXPORT int adl_generateFormat(struct ADL_MIDIPlayer *device, int sampleC
     }
 
     return static_cast<int>(gotten_len);
+}
+#endif
+
+ADLMIDI_EXPORT int adl_generateFormat(struct ADL_MIDIPlayer *device, int sampleCount,
+                                      ADL_UInt8 *out_left, ADL_UInt8 *out_right,
+                                      const ADLMIDI_AudioFormat *format)
+{
+#ifdef ADLMIDI_HW_OPL
+    ADL_UNUSED(device);
+    ADL_UNUSED(sampleCount);
+    ADL_UNUSED(out_left);
+    ADL_UNUSED(out_right);
+    ADL_UNUSED(format);
+    return 0;
+#else
+    GenerateTarget target = {out_left, out_right, format, NULL, NULL, 0};
+    return GenerateInto(device, sampleCount, target);
+#endif
+}
+
+ADLMIDI_EXPORT int adl_generateDouble(struct ADL_MIDIPlayer *device, int sampleCount,
+                                      double *out_left, double *out_right, unsigned stride)
+{
+#ifdef ADLMIDI_HW_OPL
+    ADL_UNUSED(device);
+    ADL_UNUSED(sampleCount);
+    ADL_UNUSED(out_left);
+    ADL_UNUSED(out_right);
+    ADL_UNUSED(stride);
+    return 0;
+#else
+    // Without both buffers there is nowhere to write, and the target would
+    // otherwise be taken for the one in bytes.
+    if(!out_left || !out_right)
+        return 0;
+    GenerateTarget target = {NULL, NULL, NULL, out_left, out_right, stride};
+    return GenerateInto(device, sampleCount, target);
 #endif
 }
 
