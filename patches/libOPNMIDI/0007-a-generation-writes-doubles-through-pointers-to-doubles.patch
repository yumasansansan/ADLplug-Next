+/*
+    Where the samples of a generation go: the bytes of two buffers, in the
+    format that opn2_generateFormat() is given, or doubles through two
+    pointers of their own type, as opn2_generateDouble() writes them.
+*/
+struct GenerateTarget
+{
+    OPN2_UInt8 *left;
+    OPN2_UInt8 *right;
+    const OPNMIDI_AudioFormat *format;
+    double *leftDouble;
+    double *rightDouble;
+    size_t stride;
+};
+
+static int SendGenerated(int samples_requested, ssize_t in_size, int32_t *in, ssize_t out_pos,
+                         const GenerateTarget &target)
+{
+    if(target.leftDouble)
+        return SendStereoDouble(samples_requested, in_size, in, out_pos,
+                                target.leftDouble, target.rightDouble, target.stride);
+    return SendStereoAudio(samples_requested, in_size, in, out_pos,
+                           target.left, target.right, target.format);
+}
+
+static int GenerateInto(struct OPN2_MIDIPlayer *device, int sampleCount, const GenerateTarget &target)
 {
     sampleCount -= sampleCount % 2; //Avoid even sample requests
     if(sampleCount < 0)
