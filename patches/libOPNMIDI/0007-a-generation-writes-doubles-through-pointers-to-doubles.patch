-            if(SendStereoAudio(sampleCount, in_generatedStereo, out_buf, gotten_len, out_left, out_right, format) == -1)
+            if(SendGenerated(sampleCount, in_generatedStereo, out_buf, gotten_len, target) == -1)
                 return 0;
 
             left -= (int)in_generatedPhys;
@@ -1344,6 +1395,25 @@ OPNMIDI_EXPORT int opn2_generateFormat(struct OPN2_MIDIPlayer *device, int sampl
     return static_cast<int>(gotten_len);
 }
 
+OPNMIDI_EXPORT int opn2_generateFormat(struct OPN2_MIDIPlayer *device, int sampleCount,
+                                       OPN2_UInt8 *out_left, OPN2_UInt8 *out_right,
+                                       const OPNMIDI_AudioFormat *format)
+{
+    GenerateTarget target = {out_left, out_right, format, NULL, NULL, 0};
+    return GenerateInto(device, sampleCount, target);
+}
+
+OPNMIDI_EXPORT int opn2_generateDouble(struct OPN2_MIDIPlayer *device, int sampleCount,
+                                       double *out_left, double *out_right, unsigned stride)
+{
+    // Without both buffers there is nowhere to write, and the target would
+    // otherwise be taken for the one in bytes.
+    if(!out_left || !out_right)
+        return 0;
+    GenerateTarget target = {NULL, NULL, NULL, out_left, out_right, stride};
+    return GenerateInto(device, sampleCount, target);
+}
