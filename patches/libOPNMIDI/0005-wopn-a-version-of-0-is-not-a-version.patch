WOPN: a version of 0 is not a version

A WOPN bank or OPNI file of version 1 has no version code; one that has it is
of version 2 or later. The loaders read the code and turn away only a version
newer than they know, so they take a version of 0. Saving uses 0 for "the
latest version", so such a file does not survive being saved in its own
version and loaded back. It is the same fault as libADLMIDI's WOPL loaders
have, which a fuzzer found.

Both loaders now turn a version of 0 away, with a new error code at the end of
the enumeration, WOPN_ERR_INVALID_VERSION, and the loading of a custom bank
says so. Files that any tool writes are not affected.

This is ADLplug-Next's own patch, applied to the submodule by
cmake/Patches.cmake when CMake configures, and it goes away once the change is
upstream.

diff --git a/src/opnmidi_load.cpp b/src/opnmidi_load.cpp
index 178a720..45e931b 100644
--- a/src/opnmidi_load.cpp
+++ b/src/opnmidi_load.cpp
@@ -101,6 +101,9 @@ bool OPNMIDIplay::LoadBank(FileAndMemReader &fr)
         case WOPN_ERR_NEWER_VERSION:
             errorStringOut = "Custom bank: Version is newer than supported by this library!";
             return false;
+        case WOPN_ERR_INVALID_VERSION:
+            errorStringOut = "Custom bank: Invalid version!";
+            return false;
         case WOPN_ERR_OUT_OF_MEMORY:
             errorStringOut = "Custom bank: Out of memory!";
             return false;
diff --git a/src/wopn/wopn_file.c b/src/wopn/wopn_file.c
index 5941882..640e766 100644
--- a/src/wopn/wopn_file.c
+++ b/src/wopn/wopn_file.c
@@ -270,6 +270,11 @@ WOPNFile *WOPN_LoadBankFromMem(void *mem, size_t length, int *error)
             return NULL;
         }
         version = toUint16LE(cursor);
+        if(version == 0)
+        {
+            SET_ERROR(WOPN_ERR_INVALID_VERSION);
+            return NULL;
+        }
         if(version > wopn_latest_version)
         {
             SET_ERROR(WOPN_ERR_NEWER_VERSION);
@@ -386,6 +391,8 @@ int WOPN_LoadInstFromMem(OPNIFile *file, void *mem, size_t length)
         if(length < 2)
             return WOPN_ERR_UNEXPECTED_ENDING;
         version = toUint16LE(cursor);
+        if(version == 0)
+            return WOPN_ERR_INVALID_VERSION;
         if(version > wopn_latest_version)
             return WOPN_ERR_NEWER_VERSION;
         GO_FORWARD(2);
diff --git a/src/wopn/wopn_file.h b/src/wopn/wopn_file.h
index fda584f..72462d4 100644
--- a/src/wopn/wopn_file.h
+++ b/src/wopn/wopn_file.h
@@ -95,7 +95,9 @@ typedef enum WOPN_ErrorCodes
     /* Out of memory */
     WOPN_ERR_OUT_OF_MEMORY,
     /* Given null pointer memory data */
-    WOPN_ERR_NULL_POINTER
+    WOPN_ERR_NULL_POINTER,
+    /* Version of file is not a version of the format */
+    WOPN_ERR_INVALID_VERSION
 } WOPN_ErrorCodes;
 
