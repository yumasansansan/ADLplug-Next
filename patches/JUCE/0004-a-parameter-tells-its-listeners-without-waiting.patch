 void AudioProcessorParameter::addListener (AudioProcessorParameter::Listener* newListener)
 {
     const ScopedLock sl (listenerLock);
-    listeners.addIfNotAlreadyThere (newListener);
+
+    ListenerArray updated;
+
+    if (auto* current = currentListeners.load())
+        updated = *current;
+
+    updated.addIfNotAlreadyThere (newListener);
+    publishListeners (std::move (updated));
 }
 
 void AudioProcessorParameter::removeListener (AudioProcessorParameter::Listener* listenerToRemove)
 {
     const ScopedLock sl (listenerLock);
-    listeners.removeFirstMatchingValue (listenerToRemove);
+
+    auto* current = currentListeners.load();
+
+    if (current == nullptr)
+        return;
+
+    ListenerArray updated (*current);
+    updated.removeFirstMatchingValue (listenerToRemove);
+    publishListeners (std::move (updated));
 }
 
