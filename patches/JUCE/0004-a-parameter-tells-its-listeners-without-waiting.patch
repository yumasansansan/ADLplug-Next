+}
+
+void AudioProcessorParameter::publishListeners (ListenerArray updated)
+{
+    auto next = std::make_unique<const ListenerArray> (std::move (updated));
+
+    if (auto* previous = currentListeners.exchange (next.release()))
+        retiredListeners.emplace_back (previous);
+
+    if (notificationsOnThisThread == 0)
+        while (notificationsInFlight.load() != 0)
+            Thread::yield();
+
+    if (notificationsInFlight.load() == 0)
+        retiredListeners.clear();
 }
 
