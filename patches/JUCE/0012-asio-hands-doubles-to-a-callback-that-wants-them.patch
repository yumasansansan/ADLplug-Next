+    static void convertFloat32ToDouble (const char* src, double* dest, int numSamples, bool littleEndian) noexcept
+    {
+        while (--numSamples >= 0)
+        {
+            const auto bits = littleEndian ? ByteOrder::littleEndianInt (src) : ByteOrder::bigEndianInt (src);
+            float value;
+            std::memcpy (&value, &bits, sizeof (value));
+            *dest++ = value;
+            src += sizeof (value);
+        }
+    }
+
+    static void convertDoubleToFloat32 (const double* src, char* dest, int numSamples, bool littleEndian) noexcept
+    {
+        while (--numSamples >= 0)
+        {
+            const auto value = (float) *src++;
+            uint32 bits;
+            std::memcpy (&bits, &value, sizeof (bits));
+            bits = littleEndian ? ByteOrder::swapIfBigEndian (bits) : ByteOrder::swapIfLittleEndian (bits);
+            std::memcpy (dest, &bits, sizeof (bits));
+            dest += sizeof (bits);
+        }
+    }
+
+    template <typename Sample>
+    static void convertFloat64ToFloat (const char* src, Sample* dest, int numSamples, bool littleEndian) noexcept
+    {
+        while (--numSamples >= 0)
+        {
+            const auto bits = littleEndian ? ByteOrder::littleEndianInt64 (src) : ByteOrder::bigEndianInt64 (src);
+            double value;
+            std::memcpy (&value, &bits, sizeof (value));
+            *dest++ = (Sample) value;
+            src += sizeof (value);
+        }
+    }
+
+    template <typename Sample>
+    static void convertFloatToFloat64 (const Sample* src, char* dest, int numSamples, bool littleEndian) noexcept
+    {
+        while (--numSamples >= 0)
+        {
+            const auto value = (double) *src++;
+            uint64 bits;
+            std::memcpy (&bits, &value, sizeof (bits));
+            bits = littleEndian ? ByteOrder::swapIfBigEndian (bits) : ByteOrder::swapIfLittleEndian (bits);
+            std::memcpy (dest, &bits, sizeof (bits));
+            dest += sizeof (bits);
+        }
+    }
 };
 
