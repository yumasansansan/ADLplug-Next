     std::atomic<bool> quitMessagePosted { false }, quitMessageReceived { false };
-    Thread::ThreadID messageThreadId;
+    // Which thread the messages belong to. isThisTheMessageThread() is asked
+    // wherever a parameter change is passed on, which JUCE says is done on the
