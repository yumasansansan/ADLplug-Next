#
# libFuzzer's dictionary for the OPL3 build's bank_file target (-dict=): the
# words that open each kind of file it reads, so that made-up inputs get past
# the first check (libADLMIDI's wopl_file.c, Instrument::from_sbi).

wopl_bank="WOPL3-BANK\x00"
wopl_instrument="WOPL3-INST\x00"
sbi_dos="SBI\x1a"
sbi_unix_2op="2OP\x1a"
sbi_unix_4op="4OP\x1a"
sbi_other="SBI"
