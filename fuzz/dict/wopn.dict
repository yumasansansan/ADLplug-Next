#
# libFuzzer's dictionary for the OPN2 build's bank_file target (-dict=): the
# words that open each kind of file it reads, both versions of each, so that
# made-up inputs get past the first check (libOPNMIDI's wopn_file.c).

wopn_bank_1="WOPN2-BANK\x00"
wopn_bank_2="WOPN2-B2NK\x00"
opni_instrument_1="WOPN2-INST\x00"
opni_instrument_2="WOPN2-IN2T\x00"
